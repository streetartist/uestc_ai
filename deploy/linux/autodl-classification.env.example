# Organizer-only native evaluation instance. Never hand its SSH credentials to teams.
EVALUATION_API_BASE=https://uestcai.top/api
EVALUATION_WORKER_TOKEN=replace-with-organizer-worker-token
EVALUATION_AUTODL_IMAGE_UUID=image-replace-with-saved-private-image
EVALUATION_WORKER_ID=wujie-classification-4080
# Leave GPU UUID unset for a single-GPU instance; the worker discovers it.
# EVALUATION_GPU_DEVICE=GPU-...
# Embedded organizer image; thin images can override this with an external dataset directory.
EVALUATION_CLASSIFICATION_DATASETS=/opt/uestc-classification/datasets
EVALUATION_LOG_DIRECTORY=/root/autodl-tmp/uestc-evaluation/logs
# Every redirect target must also be on this explicit allowlist.
EVALUATION_MODEL_HOSTS=huggingface.co,*.huggingface.co,*.hf.co
