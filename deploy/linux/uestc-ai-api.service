[Unit]
Description=UESTC AI API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=uestc-ai
Group=uestc-ai
WorkingDirectory=/opt/uestc-ai/current/backend
EnvironmentFile=/etc/uestc-ai/backend.env
ExecStart=/opt/uestc-ai/shared/venv/bin/gunicorn app:app --bind 127.0.0.1:5000 --worker-class gthread --workers 2 --threads 4 --timeout 180 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/uestc-ai/shared
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
