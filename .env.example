# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api

# Flask and database
# The SQLite path is resolved from the repository root when using the commands
# in README.md. Use a postgresql+psycopg:// URL in production.
DATABASE_URL=sqlite:///backend/data/uestc_ai.sqlite3
SECRET_KEY=dev-only-change-me-before-production
CORS_ORIGINS=
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Local bootstrap. Set both values to 0 in production and run migrations.
AUTO_CREATE_SCHEMA=1
SEED_DATABASE=1
INITIAL_ADMIN_EMAIL=admin@uestcai.top
INITIAL_ADMIN_PASSWORD=dev-only-change-me-123
INITIAL_REVIEWER_EMAIL=reviewer@uestc.ai
INITIAL_REVIEWER_PASSWORD=dev-only-change-me-123

# Disabling deadline enforcement locally makes the complete fictional demo workflow testable.
ENFORCE_COMPETITION_DEADLINES=0

# Email verification. With no provider key, local development can expose the
# code in the API response. Never enable this in production.
RESEND_API_KEY=
RESEND_FROM="UESTC AI <noreply@example.com>"
EXPOSE_VERIFICATION_CODE=1

# Dedicated evaluation workers. Leave disabled until trusted adapter images are installed.
EVALUATION_WORKER_TOKEN=
EVALUATION_ENABLED_ADAPTERS=
EVALUATION_API_BASE=http://127.0.0.1:5000/api
# Optional worker restriction, e.g. robot-arm-agent-v1; blank handles all registered runtimes.
EVALUATION_WORKER_ADAPTERS=
# Private persistent container logs, camera frames and physical trajectories.
EVALUATION_LOG_DIRECTORY=
EVALUATION_ADAPTER_MANIFEST_DIR=
EVALUATION_API_URL=
EVALUATION_API_KEY=

# AI API platform. Generate a random secret; keep it stable to decrypt upstream keys.
AI_GATEWAY_ENCRYPTION_KEY=
# Only enable this for local OpenAI-compatible GPU services on loopback.
AI_GATEWAY_ALLOW_LOCAL_HTTP=0
# AutoDL Pro simulator on loopback only; keep disabled for real providers.
COMPUTE_ALLOW_LOCAL_HTTP=0
