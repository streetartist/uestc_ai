FROM python:3.11-slim-bookworm
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libosmesa6 libgl1 libglib2.0-0 gcc libc6-dev linux-libc-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'robosuite==1.5.2' 'mujoco==3.3.7' 'numpy==1.26.4' 'Pillow==11.3.0'
COPY backend/evaluation_adapters /runner/evaluation_adapters
ENV PYTHONPATH=/runner PYTHONDONTWRITEBYTECODE=1 MUJOCO_GL=osmesa PYOPENGL_PLATFORM=osmesa NUMBA_CACHE_DIR=/tmp/numba HOME=/tmp
CMD ["python", "-m", "evaluation_adapters.robot_arm_runner"]
