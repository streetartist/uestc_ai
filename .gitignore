# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# next.js
/.next/
/.vinext/
/.vite/
*.tsbuildinfo
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local build and deployment archives
/deploy*.tar.gz
/deploy*.zip
/site-archive*.tar.gz

# Flask runtime data
/backend/data/
/backend/uploads/
__pycache__/
*.py[cod]
*.sqlite
*.sqlite3
/.venv/
/venv/
/.npm-cache/
/.pnpm-store/
